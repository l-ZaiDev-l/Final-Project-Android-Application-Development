<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/SettingsHeader"
            android:text="@string/setting_theme" />

        <RadioGroup
            android:id="@+id/themeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/themeSystem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/theme_system" />

            <RadioButton
                android:id="@+id/themeLight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/theme_light" />

            <RadioButton
                android:id="@+id/themeDark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/theme_dark" />
        </RadioGroup>

        <TextView
            style="@style/SettingsHeader"
            android:text="@string/setting_sort" />

        <RadioGroup
            android:id="@+id/sortGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/sortTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sort_title" />

            <RadioButton
                android:id="@+id/sortAuthor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sort_author" />

            <RadioButton
                android:id="@+id/sortRecent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sort_recent" />

            <RadioButton
                android:id="@+id/sortRating"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sort_rating" />

            <RadioButton
                android:id="@+id/sortProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sort_progress" />
        </RadioGroup>

        <TextView
            style="@style/SettingsHeader"
            android:text="@string/setting_display" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/compactSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_compact" />

        <TextView
            style="@style/SettingsHeader"
            android:text="@string/daily_goal" />

        <TextView
            android:id="@+id/goalValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <com.google.android.material.slider.Slider
            android:id="@+id/goalSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/daily_goal"
            android:stepSize="5"
            android:value="20"
            android:valueFrom="5"
            android:valueTo="200"
            app:labelBehavior="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/settings_footer"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
